+            except Exception as _e:
+                print(f"[ZeroMaskFix] WARN: {_e}", flush=True)
+
+            # === GRPO race-to-bottom quality filter ===
+            # If group_max(reward) < 0.4, zero out token_level_rewards for that group
+            # so GRPO advantage = 0, no learning signal. This prevents the model from
