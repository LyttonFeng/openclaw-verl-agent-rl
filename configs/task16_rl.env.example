# Task16 RL reproduction environment template.
# Copy this file to ~/.pinchbench_env or source it after replacing placeholders.
# Do not commit real IPs, private keys, API keys, or tokens.

# Reference versions verified for this repo:
# - PinchBench benchmark: 1.2.1
# - OpenClaw CLI: 2026.4.5 (3e72c03) on Mac, 2026.4.9 (0512059) on ECS smoke
# - veRL: 0.7.1
# - vLLM: 0.10.2
# - transformers: 4.57.1
# - torch: 2.8.0+cu128 on RunPod A100 smoke
# - Python: 3.12
# - GPU: A100 80G recommended

# Model and local cache.
export VERL_MODEL=Qwen/Qwen3-1.7B
export HF_HOME=${HF_HOME:-/workspace/.cache/huggingface}
export TRANSFORMERS_CACHE=${TRANSFORMERS_CACHE:-${HF_HOME}/hub}
# Optional for private/gated models. Do not commit a real token.
export HF_TOKEN=<huggingface-token-or-empty>

# OpenClaw runtime host. For RunPod/ECS, this is usually the pod public IP and SSH port.
export OPENCLAW_HOST=<pod-or-ecs-public-ip>
export OPENCLAW_PORT=22
export OPENCLAW_USER=root
export OPENCLAW_SSH_KEY=/root/.ssh/id_ed25519

# PinchBench judge. DashScope qwen-plus is used for grading.
export DASHSCOPE_API_KEY=<dashscope-api-key>
export PINCHBENCH_GRADE_JUDGE_MODEL=qwen-plus

# Data/log paths. The repo commits data/task16_prompts/*.parquet.
export TASK16_DATA_DIR=${TASK16_DATA_DIR:-$(pwd)/data/task16_prompts}
export PINCHBENCH_TRAIN_FILE_OVERRIDE=${PINCHBENCH_TRAIN_FILE_OVERRIDE:-${TASK16_DATA_DIR}/train.parquet}
export PINCHBENCH_VAL_FILE_OVERRIDE=${PINCHBENCH_VAL_FILE_OVERRIDE:-${TASK16_DATA_DIR}/val.parquet}
export TRAIN_LOG_PATH=${TRAIN_LOG_PATH:-$(pwd)/logs/task16_rl.log}
export REBUILD_TASK16_DATA=0

# Short reproduction defaults. Use 4 steps first as an end-to-end smoke.
export TOTAL_TRAINING_STEPS=${TOTAL_TRAINING_STEPS:-32}
export TOTAL_EPOCHS=${TOTAL_EPOCHS:-4}
export TEST_FREQ=${TEST_FREQ:-4}
export SAVE_FREQ=${SAVE_FREQ:-4}
export BATCH_SIZE=${BATCH_SIZE:-1}
export MICRO_BATCH=${MICRO_BATCH:-1}

# Agent rollout limits.
export MAX_TURNS=8
export MAX_PROMPT_LENGTH=20000
export MAX_RESPONSE_LENGTH=12000
export VLLM_MAX_MODEL_LEN=32768
export PINCHBENCH_AGENT_LOOP_RUNTIME=benchmark
export PINCHBENCH_OPENCLAW_CONTEXT_WINDOW=32768
export PINCHBENCH_OPENCLAW_MAX_TOKENS=8192
export PINCHBENCH_TASK16_MAX_TOKENS_PER_TURN=8192
export PINCHBENCH_BENCHMARK_MODEL_ID=${VERL_MODEL##*/}
export OPENCLAW_MODEL_REASONING=0
export PINCHBENCH_MODEL_TEMPERATURE=0.7
export PINCHBENCH_MODEL_TOP_P=0.8
export PINCHBENCH_MODEL_TOP_K=20
export PINCHBENCH_RL_INJECT_TOOL_FORMAT_SUFFIX=1
export PINCHBENCH_ROLLOUT_DIAGNOSTICS_PATH=$(pwd)/logs/task16_rollout_diagnostics.jsonl
export PINCHBENCH_DISABLE_DEFAULT_SKILLS=1
export PINCHBENCH_CLEANUP_REMOTE_AGENT=1
export PINCHBENCH_CLEANUP_REMOTE_WORKSPACE=1
export PPO_MAX_TOKEN_LEN_PER_GPU=32768
export REF_LOG_PROB_MAX_TOKEN_LEN_PER_GPU=32768
export VLLM_GPU_MEM_UTIL=0.22
export VLLM_MAX_NUM_SEQS=8
export ROLLOUT_TEMPERATURE=0.8
# Keep these false unless flash-attn is installed in the training environment.
export MODEL_USE_REMOVE_PADDING=${MODEL_USE_REMOVE_PADDING:-False}
export ACTOR_USE_REMOVE_PADDING=${ACTOR_USE_REMOVE_PADDING:-False}

# Training rollout sampling. This is the stochastic policy rollout used for RL.
export ROLLOUT_TEMPERATURE=0.8
export ROLLOUT_TOP_P=0.9
export ROLLOUT_TOP_K=-1

# Validation rollout.
export VAL_DO_SAMPLE=False
export VAL_TEMPERATURE=1.0
export VAL_TOP_P=1.0
export VAL_TOP_K=-1
export VAL_N=1

# Reward and RL algorithm behavior.
export REWARD_MODE=task16-event-only-v2
export PINCHBENCH_REWARD_RETURN_MODE=turn
export PINCHBENCH_REWARD_ASSIGNMENT=turn_broadcast
export PINCHBENCH_NO_MASKED_WHITEN=1
export PINCHBENCH_TASK16_TERMINAL_REWARD_WEIGHT=0.8
export PINCHBENCH_TASK_EMA_INIT=0.0
export PINCHBENCH_TASK_EMA_ALPHA=0.05
export PINCHBENCH_TASK_EMA_VAR_INIT=0.0
